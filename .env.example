# MARS ortam degiskenleri ornegi
# Kopyalayin: cp .env.example .env

# --- Veri ---
MARS_DATA_DIR=data
MARS_CACHE_TTL_HOURS=12
MARS_LOOKBACK_DAYS=400
MARS_BENCHMARK_TICKER=XU100.IS

# --- Anomali motoru ---
MARS_MAD_SCALE=1.4826
MARS_IFOREST_TREES=200
MARS_IFOREST_CONTAMINATION=0.02
MARS_ROLLING_WINDOW=60
MARS_ESTIMATION_WINDOW=120

# --- Haber / VeriShield ---
# VeriShield gomulu (submodule). Bulunamazsa yerel sezgisel skorlayici devreye girer.
MARS_VERISHIELD_ENABLED=true
MARS_VERISHIELD_MODE=embedded        # embedded | http
MARS_VERISHIELD_BASE_URL=http://localhost:8000
MARS_VERISHIELD_ACCEPTED_LICENSE=AGPL-3.0

# --- Haber / RSS ---
MARS_RSS_ENABLED=true
MARS_RSS_FEEDS=https://www.bloomberght.com/rss/tum-haberler.xml,https://www.cnnturk.com/feed/rss/ekonomi/news
MARS_RSS_MAX_ITEMS=60

# --- ML ---
MARS_ML_ENABLED=true

# --- Duygu / LLM ---
# Saglayici secenekleri: ollama (yerel) | evren | openai | custom (OpenAI uyumlu)
# Ayarlar sayfasindan (arayuz) bu degerleri calisirken degistirebilirsiniz;
# degisiklikler data/settings.local.json dosyasina yazilir ve .env'i gecersiz kilar.
MARS_SENTIMENT_BACKEND=auto          # auto | bert | lexicon
MARS_SENTIMENT_MODEL=savasy/bert-base-turkish-sentiment-cased
MARS_LLM_ENABLED=true
MARS_LLM_PROVIDER=ollama             # ollama | evren | openai | custom
MARS_LLM_BASE_URL=http://localhost:11434/v1
MARS_LLM_MODEL=qwen2.5:3b-instruct
MARS_LLM_API_KEY=                    # uzak saglayici icin (or. evren_llm_...)
MARS_LLM_TIMEOUT=180
MARS_LLM_THINKING=false              # akil yuruten modellerde dusunmeyi kapat
MARS_LLM_MAX_TOKENS=2048
MARS_LLM_TEMPERATURE=0.3

# Ornek: EVREN LLM Gateway (X-API-Key ile)
# MARS_LLM_PROVIDER=evren
# MARS_LLM_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
# MARS_LLM_MODEL=qwen3.8-flash-next
# MARS_LLM_API_KEY=evren_llm_...
